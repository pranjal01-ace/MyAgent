# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ace_ai
USE_POSTGRES=true

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Qdrant Vector Database Configuration
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge
# Optional local storage fallback if Qdrant server is not running:
QDRANT_STORAGE_PATH=./data/qdrant

# Speech-to-Text (Faster-Whisper) Configuration
WHISPER_MODEL=tiny.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
STT_LANGUAGE=auto

# Voice Activity Detection (Silero VAD) Parameters
VAD_THRESHOLD=0.5
MIN_SPEECH_DURATION=0.25
MIN_SILENCE_DURATION=0.6
MAX_UTTERANCE_DURATION=30.0

# Retrieval-Augmented Generation (RAG) Parameters
RAG_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Conversation Memory
MAX_HISTORY_MESSAGES=20

# Optional Wake Word
WAKE_WORD_ENABLED=false
WAKE_WORD=computer

# Text-to-Speech Settings
TTS_VOICE=en-US-GuyNeural
TTS_SPEED=1.0
