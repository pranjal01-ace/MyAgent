{
  "metadata": {
    "dataset_name": "ace_conversational_context_benchmark",
    "version": "1.0.0",
    "description": "Evaluation dataset for conversational context classification, entity/topic tracking, reference resolution, and correction detection.",
    "target_model": "Portgas D. Ace AI Companion",
    "total_dialogues": 12,
    "total_turns": 40
  },
  "dialogues": [
    {
      "dialogue_id": "diag_001_apple_ambiguity_and_correction",
      "description": "Ambiguous Apple inquiry followed by explicit fruit correction and follow-up reference",
      "turns": [
        {
          "turn_index": 1,
          "user_message": "What is Apple?",
          "previous_context": null,
          "expected_context_type": "AMBIGUOUS",
          "expected_topic": "apple",
          "expected_entity": null,
          "expected_references_previous": false,
          "ambiguity_candidates": ["fruit", "technology_company"]
        },
        {
          "turn_index": 2,
          "user_message": "No, I mean fruit.",
          "previous_context": {"topic": "apple", "entity": "technology_company"},
          "expected_context_type": "CORRECTION",
          "expected_topic": "apple",
          "expected_entity": "fruit",
          "expected_references_previous": true,
          "correction_target": "technology_company"
        },
        {
          "turn_index": 3,
          "user_message": "Where does it grow?",
          "previous_context": {"topic": "apple", "entity": "fruit"},
          "expected_context_type": "FOLLOW_UP",
          "expected_topic": "apple",
          "expected_entity": "fruit",
          "expected_references_previous": true,
          "resolved_coreference": {"pronoun": "it", "entity": "apple fruit"}
        },
        {
          "turn_index": 4,
          "user_message": "What is Apple?",
          "previous_context": {"topic": "apple", "entity": "fruit"},
          "expected_context_type": "FOLLOW_UP",
          "expected_topic": "apple",
          "expected_entity": "fruit",
          "expected_references_previous": true,
          "expected_cache_entity": "fruit"
        }
      ]
    },
